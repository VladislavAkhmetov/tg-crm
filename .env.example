# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# Admin Telegram IDs (comma-separated, e.g. 12345678,87654321)
ADMIN_IDS=12345678,87654321

# Target Telegram Group Chat ID for team notifications (e.g. -1001234567890)
GROUP_CHAT_ID=-1001234567890

# Server & Domain Configuration
HOST=0.0.0.0
PORT=8000
BASE_URL=https://crm.example.com
APP_DOMAIN=crm.example.com
ACME_EMAIL=admin@example.com

# Deployment Configuration
DEPLOY_SERVER_HOST=your_server_ip
DEPLOY_SSH_KEY=~/.ssh/id_rsa
# DEPLOY_SERVER_PASS=your_server_password

# Testing & Security
# Set to True for local testing in a normal browser (adds mock user selector)
# Set to False in production for strict Telegram initData cryptographic validation
DEV_MODE=True

# S3 Backup Configuration
S3_KEY_ID=your_s3_key_id
S3_SECRET=your_s3_secret_key
S3_BUCKET=your-backup-bucket
S3_ENDPOINT=https://storage.yandexcloud.net
